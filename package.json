{
  "name": "af-image-optimizer",
  "version": "0.2.0",
  "description": "Private, in-browser image optimizer: batch-compress JPG/PNG/WebP/HEIC with smart quality (SSIM) and target-size modes. Library, web component, input enhancer and iframe embed.",
  "license": "MIT AND LGPL-3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azimfakhri/af-image-optimizer.git"
  },
  "homepage": "https://github.com/azimfakhri/af-image-optimizer#readme",
  "keywords": [
    "image",
    "compression",
    "optimizer",
    "webp",
    "mozjpeg",
    "wasm",
    "browser",
    "web-component",
    "resize",
    "heic"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/lib-entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib-entry.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./element": {
      "types": "./dist-lib/types/element-entry.d.ts",
      "import": "./dist-lib/element.js"
    }
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "sideEffects": [
    "./dist-lib/element.js",
    "./src/element-entry.ts",
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm test && npm run build:lib",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fflate": "^0.8.3",
    "libheif-js": "^1.23.5",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
